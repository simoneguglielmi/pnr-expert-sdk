{
  "name": "pnr-expert-sdk",
  "version": "0.0.5",
  "description": "pnr expert sdk",
  "repository": {},
  "keywords": [
    "pnr",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn check && yarn tsdown",
    "prepare": "yarn build",
    "test": "vitest run",
    "publish": "npm publish",
    "check": "biome check --write src"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.3.0",
    "dotenv": "^17.3.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
